---
import BrandMark from './BrandMark.astro';
const pillars = [
  { title: 'Diseño exclusivo para mujer', text: 'Moldería pensada para el cuerpo femenino, de la chaqueta al pantalón. Nada de cortes unisex ni talles genéricos.' },
  { title: 'Una paleta curada', text: 'Cinco colores elegidos para expresar tu estilo y combinar con tu servicio y tu equipo.' },
  { title: 'Atención uno a uno', text: 'Te asesoramos personalmente con el talle y el color para que aciertes desde el primer pedido.' },
];
---
<section class="manifesto section" aria-labelledby="manifesto-title">
  <div class="wrap">
    <BrandMark kind="mark" tone="gold" class="m-mark" />
    <h2 id="manifesto-title" data-reveal="rise-blur">
      Pasás más horas con tu ambo que con cualquier otra prenda.
      <em class="accent">Merece ser la más linda que tenés.</em>
    </h2>
    <dl class="pillars">
      {pillars.map((p, i) => (
        <div data-reveal class={`pillar i-${i}`}>
          <dt>{p.title}</dt>
          <dd>{p.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .manifesto {
    text-align: center;
  }
  .manifesto :global(.m-mark) {
    width: 3.25rem;
    margin: 0 auto var(--s-6);
  }
  h2 {
    max-width: 56rem;
    margin-inline: auto;
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1.1;
  }
  h2 em {
    display: block;
    margin-top: 0.15em;
    color: var(--gold-700);
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    border-top: 1px solid var(--line);
    text-align: left;
  }
  .pillar {
    padding: var(--s-6) var(--s-6) 0;
  }
  .pillar + .pillar {
    border-left: 1px solid var(--line);
  }
  .i-1 { --i: 1; }
  .i-2 { --i: 2; }
  dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.15;
    margin-bottom: var(--s-3);
  }
  dd {
    color: var(--ink-2);
    max-width: 30ch;
  }
  @media (max-width: 820px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
    }
    .pillar {
      padding: var(--s-5) 0;
    }
    .pillar + .pillar {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
