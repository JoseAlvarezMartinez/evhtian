---
import Icon from './Icon.astro';
import { faqs } from '../data/faq';
---
<section id="preguntas" class="faq section" aria-labelledby="preguntas-title">
  <div class="wrap faq-grid">
    <header class="section-head">
      <h2 id="preguntas-title" data-reveal>Preguntas frecuentes</h2>
      <p data-reveal>¿Te quedó alguna duda? Escribinos por WhatsApp y te respondemos personalmente.</p>
    </header>
    <div class="list">
      {faqs.map((f, i) => (
        <details class="item" name="faq" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <Icon name="plus" class="faq-icon" />
          </summary>
          <div class="answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 1rem + 4vw, 6rem);
    align-items: start;
  }
  .list {
    border-top: 1px solid var(--ink);
  }
  .item {
    border-bottom: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.2;
    transition: color var(--dur-2) var(--ease-out);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--gold-700);
  }
  summary :global(.faq-icon) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--gold-700);
    transition: transform 500ms var(--ease-out);
  }
  .item[open] summary :global(.faq-icon) {
    transform: rotate(45deg);
  }
  .item::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 500ms var(--ease-out),
      content-visibility 500ms allow-discrete;
  }
  .item[open]::details-content {
    height: auto;
  }
  .answer p {
    padding-bottom: 1.5rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
