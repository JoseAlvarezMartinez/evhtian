---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { instagramHref } from '../config/site';

const links = [
  { href: '/#coleccion', label: 'Colección' },
  { href: '/#colores', label: 'Colores' },
  { href: '/#tela', label: 'La tela' },
  { href: '/#pagos', label: 'Pagos' },
  { href: '/#envios', label: 'Envíos' },
  { href: '/#preguntas', label: 'Preguntas' },
];
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <button class="menu-btn" type="button" popovertarget="menu" aria-label="Abrir menú">
      <span></span><span></span>
    </button>

    <a href="/" class="brand" aria-label="Evhtian, inicio">
      <BrandMark kind="mark" tone="gold" class="brand-mark" />
      <BrandMark kind="wordmark" tone="gold" class="brand-word" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn ig" href={instagramHref} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Evhtian">
        <Icon name="instagram" />
      </a>
      <button class="icon-btn cart-btn" type="button" data-cart-open aria-label="Abrir carrito, 0 ambos" data-cart-label>
        <Icon name="bag" />
        <span class="cart-count tnum" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>

  <div id="menu" class="menu" popover>
    <div class="menu-head">
      <BrandMark kind="wordmark" tone="gold" class="menu-word" />
      <button class="icon-btn" type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Cerrar menú">
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label="Menú móvil">
      <ul role="list">
        {links.map((l) => <li><a href={l.href} data-menu-link>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--block" href="/#coleccion" data-menu-link>Elegí tu ambo</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(251 250 247 / 0.86);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }
  .site-header.is-scrolled {
    border-color: var(--line);
    box-shadow: 0 8px 24px -18px rgb(21 19 15 / 0.35);
    background: rgb(251 250 247 / 0.94);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-5);
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }
  .brand :global(.brand-mark) {
    width: 2.1rem;
  }
  .brand :global(.brand-word) {
    width: 9.5rem;
  }
  .nav ul {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 0.2rem + 1.6vw, 2.25rem);
  }
  .nav a {
    position: relative;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.5rem;
    transition: color var(--dur-2) var(--ease-out);
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: var(--gold-600);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .icon-btn {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    transition: background-color var(--dur-1) var(--ease-out);
  }
  .icon-btn:hover {
    background: var(--paper-2);
  }
  .icon-btn :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  .cart-count {
    position: absolute;
    top: 0.2rem;
    right: 0.1rem;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.3rem;
    border-radius: 1rem;
    background: var(--ink);
    color: var(--gold-200);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.15rem;
    text-align: center;
  }
  .cart-count.bump {
    animation: bump 600ms var(--ease-out);
  }
  @keyframes bump {
    0% { transform: scale(1); }
    30% { transform: scale(1.45); background: var(--gold-600); color: var(--paper); }
    100% { transform: scale(1); }
  }
  .menu-btn {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    padding: 0.8rem 0.6rem;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }
  .menu-btn span {
    display: block;
    height: 1.5px;
    background: var(--ink);
  }
  .menu-btn span:last-child {
    width: 65%;
  }

  .menu {
    inset: 0 auto 0 0;
    width: min(86vw, 22rem);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--s-5);
    border: 0;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-3);
    flex-direction: column;
    gap: var(--s-6);
    transform: translateX(-100%);
    transition:
      transform 420ms var(--ease-out),
      overlay 420ms allow-discrete,
      display 420ms allow-discrete;
  }
  .menu:popover-open {
    display: flex;
    transform: none;
  }
  @starting-style {
    .menu:popover-open {
      transform: translateX(-100%);
    }
  }
  .menu::backdrop {
    background: rgb(15 14 12 / 0.4);
  }
  .menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-head :global(.menu-word) {
    width: 8.5rem;
  }
  .menu ul {
    display: grid;
  }
  .menu li a {
    display: block;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.6rem;
    text-decoration: none;
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .bar {
      grid-template-columns: 1fr auto 1fr;
    }
    .brand {
      justify-self: center;
    }
    .actions {
      justify-self: end;
    }
  }
  @media (max-width: 480px) {
    .brand :global(.brand-word) {
      width: 7.5rem;
    }
    .brand :global(.brand-mark) {
      width: 1.75rem;
    }
    .ig {
      display: none;
    }
  }
</style>
