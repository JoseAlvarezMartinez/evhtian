---
import ProductVisual from './ProductVisual.astro';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { site, formatARS, saleOff, saleSaving } from '../config/site';
import { colors, models } from '../data/catalog';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-head">
      <h1 id="hero-title">
        <span class="hero-kicker">Ambos médicos para mujer</span>
        <span class="line"><span>Elegancia que dura</span></span>
        <span class="line"><span><em class="accent">toda la guardia.</em></span></span>
      </h1>
      <p class="hero-sub">
        Ambos médicos de bengalina elastizada con moldería exclusiva para mujer: estilizan tu figura y acompañan cada
        movimiento. <span class="sub-extra">Empezás la guardia impecable y la terminás igual.</span>
      </p>
    </div>

    <div class="hero-actions">
      <div class="hero-price tnum">
        <p class="hp-top"><span class="sale-badge hp-off">{saleOff}% OFF</span> {site.sale.name} · hasta el {site.sale.until}</p>
        <p class="hp-line">
          <s class="was"><span class="sr-only">Antes: </span>{formatARS(site.listPrice)}</s>
          <strong><span class="sr-only">Ahora: </span>{formatARS(site.price)}</strong>
        </p>
        <p class="hp-note"><span class="saving">Ahorrás {formatARS(saleSaving)}</span> en el conjunto completo, chaqueta y pantalón.</p>
      </div>
      <div class="hero-ctas">
        <a class="btn" href="#coleccion">Elegir mi ambo <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="#colores">Ver los 5 colores</a>
      </div>
      <ul class="hero-proof" role="list">
        <li><Icon name="truck" /> Envíos a todo el país</li>
        <li><Icon name="exchange" /> Cambio de talle en 7 días</li>
        <li><Icon name="chat" /> Te asesoramos por WhatsApp</li>
      </ul>
    </div>

    <div class="hero-visual c-bordo" data-viewer data-hero data-model="essential" data-color="bordo">
      <div class="stage">
        <BrandMark kind="mark" tone="gold" sheen class="stage-mark" />
        <div class="stage-views">
          {models.map((m) => (
            <div class:list={['stage-view', m.id === 'essential' && 'is-active']} data-model-view={m.id}>
              <ProductVisual model={m.id} color="bordo" uid={`hero-${m.id}`} eager={m.id === 'essential'} sizes="(min-width: 960px) 42vw, 92vw" />
            </div>
          ))}
        </div>
        <p class="stage-caption" aria-live="polite">
          Ambo <span data-viewer-model-name>Essential</span> · <span data-viewer-color-name>Bordó</span>
        </p>
      </div>
      <div class="quick">
        <div class="seg" role="group" aria-label="Modelo">
          {models.map((m) => (
            <button type="button" class="seg-btn" data-set-model={m.id} aria-pressed={m.id === 'essential' ? 'true' : 'false'}>{m.name}</button>
          ))}
        </div>
        <div class="dots" role="group" aria-label="Color">
          {colors.map((c) => (
            <button type="button" class:list={['dot', `c-${c.id}`]} data-set-color={c.id} aria-pressed={c.id === 'bordo' ? 'true' : 'false'} aria-label={c.name} title={c.name}><span></span></button>
          ))}
        </div>
        <p class="quick-price tnum"><span class="qp-was"><s class="was">{formatARS(site.listPrice)}</s> <span class="sale-badge">−{saleOff}%</span></span> <strong>{formatARS(site.price)}</strong> <span>chaqueta + pantalón</span></p>
        <a class="btn quick-cta" href="/ambos/essential/?color=bordo" data-viewer-link>Conocer el modelo <Icon name="arrow" /></a>
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#coleccion" data-scroll-cue>
    <span>Descubrí la colección</span>
    <span class="cue-track" aria-hidden="true"><span class="cue-dot"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(1.5rem, 0.5rem + 3vw, 3.5rem);
    padding-bottom: clamp(5.5rem, 4rem + 4vw, 7.5rem);
    overflow: clip;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto auto 1fr;
    grid-template-areas:
      '. visual'
      'head visual'
      'actions visual'
      '. visual';
    column-gap: clamp(2rem, 1rem + 4vw, 6rem);
  }
  .hero-head {
    grid-area: head;
  }
  .hero-actions {
    grid-area: actions;
  }
  .hero-visual {
    grid-area: visual;
    align-self: center;
    justify-self: end;
    width: 100%;
    max-width: 31rem;
  }

  /* Copy */
  h1 {
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  /* Palabra clave principal dentro del H1, como antetítulo: es lo que se busca en Google y lo que promete el anuncio. */
  .hero-kicker {
    display: block;
    margin-bottom: var(--s-3);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-700);
  }
  h1 .line {
    display: block;
  }
  h1 .line > span {
    display: block;
  }
  h1 em {
    color: var(--gold-700);
  }
  .hero-sub {
    margin-top: var(--s-5);
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }
  .hero-price {
    margin-top: var(--s-6);
  }
  .hp-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--gold-700);
  }
  .hp-off {
    font-size: 0.8125rem;
  }
  .hp-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-4);
    margin-top: var(--s-3);
  }
  .hp-line .was {
    font-size: var(--step-2);
    font-weight: 500;
  }
  .hp-line strong {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .hp-note {
    margin-top: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .qp-was {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .qp-was .sale-badge {
    font-size: 0.6875rem;
  }
  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .hero-proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero-proof :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--gold-700);
  }

  /* Escenario */
  .hero-visual {
    position: relative;
  }
  .stage {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 80% at 50% 18%, #fffdf8 0%, rgb(255 253 248 / 0) 60%),
      linear-gradient(180deg, var(--paper-2) 0%, var(--paper-3) 100%);
    overflow: hidden;
    isolation: isolate;
  }
  .stage::after {
    /* piso */
    content: '';
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 13%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(21 19 15 / 0.16), transparent);
    z-index: -1;
  }
  .stage :global(.stage-mark) {
    position: absolute;
    z-index: 2;
    width: clamp(2.5rem, 9%, 3.5rem);
    right: var(--s-5);
    top: var(--s-4);
  }
  .stage-views {
    position: absolute;
    inset: 0;
  }
  /* El modelo inactivo queda fuera del render: sus fotos no se descargan hasta elegirlo. */
  .stage-view {
    position: absolute;
    inset: 0;
    display: none;
  }
  .stage-view.is-active {
    display: block;
    animation: view-in 700ms var(--ease-out);
  }
  @keyframes view-in {
    from { opacity: 0; transform: translateY(14px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  .stage-view :global(.pv--art) {
    padding: 7% 24% 15%;
  }
  .stage-caption {
    position: absolute;
    z-index: 2;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius);
    background: rgb(251 250 247 / 0.85);
    left: var(--s-5);
    top: var(--s-5);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .quick {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin: -4rem var(--s-4) 0;
    padding: var(--s-4);
    background: rgb(251 250 247 / 0.96);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-3);
  }

  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    min-width: 11rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
  }
  .seg-btn {
    min-height: 2.25rem;
    padding-inline: 0.6rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-3);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .seg-btn[aria-pressed='true'] {
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-1);
  }
  .dots {
    display: flex;
    justify-content: flex-end;
    gap: 0.2rem;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .dot span {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--g);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.12),
      inset 0 6px 10px -6px rgb(255 255 255 / 0.5);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .dot:hover span {
    transform: scale(1.08);
  }
  .dot[aria-pressed='true'] {
    border-color: var(--ink);
  }
  .quick-price {
    display: grid;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--ink-3);
  }
  .quick-price strong {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
  }
  .quick-cta {
    justify-self: end;
  }

  /* Indicador de scroll */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: var(--s-5);
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  :global(.has-scrolled) .scroll-cue {
    opacity: 0;
    pointer-events: none;
  }
  .cue-track {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: var(--line-strong);
    overflow: hidden;
  }
  .cue-dot {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 0.9rem;
    border-radius: 2px;
    background: var(--gold-600);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% { transform: translateY(-100%); }
    70%, 100% { transform: translateY(320%); }
  }

  /* Entrada orquestada */
  @media (prefers-reduced-motion: no-preference) {
    .hero-sub,
    .hero-ctas,
    .hero-price,
    .hero-proof {
      animation: soft-up 1s var(--ease-out) backwards;
    }
    .hero-sub { animation-delay: 0.45s; }
    .hero-price { animation-delay: 0.58s; }
    .hero-ctas { animation-delay: 0.7s; }
    .hero-proof { animation-delay: 0.82s; }
    .stage {
      animation: stage-in 1.5s var(--ease-out) 0.1s backwards;
    }
    .stage-views {
      animation: garment-in 1.4s var(--ease-out) 0.55s backwards;
    }
    .quick {
      animation: soft-up 1s var(--ease-out) 0.95s backwards;
    }
    .scroll-cue {
      animation: fade 1.2s var(--ease-out) 1.6s backwards;
    }
    @supports (animation-timeline: scroll()) {
      .stage-views {
        animation:
          garment-in 1.4s var(--ease-out) 0.55s backwards,
          drift linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 90vh;
      }
    }
  }
  /* El titular no se anima: aparece de inmediato (es el elemento LCP). */
  @keyframes soft-up {
    from { opacity: 0; transform: translateY(18px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes stage-in {
    from { clip-path: inset(10% 10% 10% 10% round 4px); opacity: 0; }
    to { clip-path: inset(0 0 0 0 round 4px); opacity: 1; }
  }
  @keyframes garment-in {
    from { opacity: 0; transform: translateY(40px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }
  @keyframes drift {
    to { translate: 0 -7%; }
  }
  @keyframes fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas: 'head' 'visual' 'actions';
      row-gap: var(--s-5);
    }
    .hero-visual {
      max-width: 34rem;
      width: 100%;
      margin-inline: auto;
    }
    .hero-price {
      margin-top: var(--s-2);
    }
    .scroll-cue {
      display: none;
    }
    .hero {
      padding-bottom: var(--section);
    }
  }
  @media (max-width: 600px) {
    h1 {
      font-size: clamp(1.85rem, 1.2rem + 3.4vw, 2.3rem);
      text-wrap: balance;
    }
    h1 .line,
    h1 .line > span {
      display: inline;
    }
    h1 .line:not(:last-child)::after {
      content: ' ';
    }
    .hero-sub {
      margin-top: var(--s-3);
      font-size: var(--step-0);
    }
    .sub-extra {
      display: none;
    }
    .stage {
      aspect-ratio: 4 / 5;
    }
  }
  @media (max-width: 480px) {
    .hero-ctas .btn {
      flex: 1 1 100%;
    }
    .quick {
      margin-inline: var(--s-3);
      padding: var(--s-4);
    }
    .stage-view :global(.pv--art) {
      padding: 15% 20% 19%;
    }
    .quick {
      grid-template-columns: minmax(0, 1fr);
    }
    .quick-cta {
      justify-self: stretch;
    }
    .stage-caption {
      display: none;
    }
    .dots {
      justify-content: flex-start;
    }
  }
</style>
