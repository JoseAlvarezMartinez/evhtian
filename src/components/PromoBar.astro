---
import { site, formatARS, saleOff } from '../config/site';
---
<div class="promo-bar">
  <p class="wrap">
    <span class="promo-long"><span class="pb-off">{saleOff}% OFF</span> <strong>{site.sale.name}:</strong> ambos de <s>{formatARS(site.listPrice)}</s> a <strong>{formatARS(site.price)}</strong> hasta el {site.sale.until}.</span>
    <span class="promo-short"><span class="pb-off">{saleOff}% OFF</span> <s>{formatARS(site.listPrice)}</s> <strong>{formatARS(site.price)}</strong> hasta el {site.sale.until}</span>
    <a href="/#coleccion">Ver ambos</a>
  </p>
</div>

<style>
  .promo-bar {
    background: var(--noir);
    color: var(--on-noir);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }
  .promo-bar p {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    min-height: 2.5rem;
    padding-block: 0.45rem;
    text-align: center;
  }
  strong {
    font-weight: 500;
    color: var(--gold-200);
  }
  s {
    color: var(--on-noir-2);
    text-decoration-thickness: 1.5px;
  }
  .pb-off {
    display: inline-block;
    margin-right: 0.35rem;
    padding: 0.2em 0.45em 0.16em;
    border-radius: var(--radius);
    background: var(--sale);
    color: #fff;
    font-weight: 700;
    font-size: 0.92em;
    letter-spacing: 0.05em;
    line-height: 1.1;
  }
  a {
    color: var(--gold-200);
    text-decoration: underline;
    text-decoration-color: rgb(230 210 154 / 0.5);
    font-weight: 500;
  }
  a:hover {
    text-decoration-color: currentColor;
  }
  .promo-short {
    display: none;
  }
  @media (max-width: 640px) {
    .promo-long {
      display: none;
    }
    .promo-short {
      display: inline;
    }
    a {
      display: none;
    }
    .promo-bar p {
      flex-wrap: nowrap;
      white-space: nowrap;
      font-size: 0.75rem;
    }
  }
</style>
