---
/** Tarjeta de presentación de un modelo: lleva a su página de detalle. */
import ProductVisual from './ProductVisual.astro';
import Icon from './Icon.astro';
import { colors, type ColorId, type Model } from '../data/catalog';
import { site, formatARS } from '../config/site';

interface Props {
  model: Model;
  color: ColorId;
  uid: string;
  headingLevel?: 'h2' | 'h3';
}
const { model, color, uid, headingLevel = 'h3' } = Astro.props;
const href = `/ambos/${model.id}/`;
const Heading = headingLevel;
---
<article class:list={['card', `c-${color}`]} data-viewer data-card data-model={model.id} data-color={color} data-href={href}>
  <div class="card-media">
    <ProductVisual model={model.id} color={color} uid={uid} sizes="(min-width: 900px) 44vw, 92vw" />
    <span class="card-chip">Chaqueta + pantalón</span>
  </div>
  <div class="card-body">
    <div class="card-title">
      <Heading class="card-name">
        <a class="card-link" href={`${href}?color=${color}`} data-viewer-link>Ambo {model.name}</a>
      </Heading>
      <p class="card-price tnum"><s>{formatARS(site.listPrice)}</s> {formatARS(site.price)}</p>
    </div>
    <p class="card-sale">{site.sale.name} · hasta el {site.sale.until}</p>
    <p class="card-tagline">{model.tagline}</p>
    <p class="card-teaser">{model.teaser}</p>
    <div class="card-foot">
      <div class="card-colors" role="group" aria-label={`Ver el ambo ${model.name} en otro color`}>
        {colors.map((c) => (
          <button
            type="button"
            class:list={['dot', `c-${c.id}`]}
            data-set-color={c.id}
            aria-pressed={c.id === color ? 'true' : 'false'}
            aria-label={c.name}
            title={c.name}
          >
            <span></span>
          </button>
        ))}
      </div>
      <span class="card-cta" aria-hidden="true">Conocer el modelo <Icon name="arrow" /></span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      box-shadow var(--dur-3) var(--ease-out),
      transform var(--dur-3) var(--ease-out),
      border-color var(--dur-3) var(--ease-out);
  }
  .card:hover {
    box-shadow: var(--shadow-3);
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }
  .card-media {
    position: relative;
    aspect-ratio: 3 / 4;
    background:
      radial-gradient(90% 70% at 50% 20%, #fffdf9 0%, rgb(255 253 249 / 0) 70%),
      var(--paper-3);
    overflow: hidden;
  }
  .card-media :global(.pv--art) {
    padding: 8% 20% 6%;
  }
  .card-media :global(.pv) {
    transition: transform 1.2s var(--ease-out);
  }
  .card:hover .card-media :global(.pv) {
    transform: scale(1.03);
  }
  .card-chip {
    position: absolute;
    left: var(--s-4);
    top: var(--s-4);
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgb(251 250 247 / 0.85);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .card-body {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5);
  }
  .card-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
  }
  .card-name {
    font-size: var(--step-3);
  }
  .card-link {
    text-decoration: none;
    color: inherit;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card:has(.card-link:focus-visible) {
    outline: 2px solid var(--gold-700);
    outline-offset: 3px;
  }
  .card-price {
    font-size: var(--step-1);
    font-weight: 600;
    white-space: nowrap;
  }
  .card-price s {
    margin-right: 0.35rem;
    font-size: 0.8em;
    font-weight: 500;
    color: var(--ink-3);
  }
  .card-sale {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--gold-700);
  }
  .card-tagline {
    color: var(--gold-700);
    font-weight: 500;
  }
  .card-teaser {
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .card-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .card-colors {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 0.35rem;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    padding: 0;
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .dot span {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--g);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  .dot[aria-pressed='true'] {
    border-color: var(--ink);
  }
  .dot:hover span {
    transform: scale(1.08);
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .card-cta :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .card:hover .card-cta :global(svg) {
    transform: translateX(4px);
  }
</style>
