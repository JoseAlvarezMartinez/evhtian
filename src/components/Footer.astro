---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { site, instagramHref, whatsappHref } from '../config/site';
const year = new Date().getFullYear();
const wa = whatsappHref('¡Hola Evhtian! Tengo una consulta.');
---
<footer class="footer">
  <div class="wrap">
    <div class="f-top">
      <div class="f-brand">
        <BrandMark kind="mark" tone="gold-light" class="f-mark" />
        <BrandMark kind="wordmark" tone="gold-light" class="f-word" />
        <p>Ambos médicos de bengalina elastizada, diseñados exclusivamente para mujer.</p>
      </div>
      <nav class="f-cols" aria-label="Pie de página">
        <div>
          <p class="f-title">Comprar</p>
          <ul role="list">
            <li><a href="/#coleccion">Colección</a></li>
            <li><a href="/#colores">Colores</a></li>
            <li><a href="/#equipo">Promo equipo</a></li>
            <li><a href="/#tela">La tela</a></li>
          </ul>
        </div>
        <div>
          <p class="f-title">Ayuda</p>
          <ul role="list">
            <li><a href="/#pagos">Medios de pago</a></li>
            <li><a href="/#preguntas">Preguntas frecuentes</a></li>
            <li><a href={wa} target="_blank" rel="noopener noreferrer">Escribinos</a></li>
          </ul>
        </div>
        <div>
          <p class="f-title">Contacto</p>
          <ul role="list">
            <li><a href={wa} target="_blank" rel="noopener noreferrer" class="f-social"><Icon name="whatsapp" /> WhatsApp</a></li>
            <li><a href={instagramHref} target="_blank" rel="noopener noreferrer" class="f-social"><Icon name="instagram" /> @{site.contact.instagram}</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="f-pay">
      <p class="f-title">Medios de pago</p>
      <ul role="list">
        {site.payments.map((p) => <li><Icon name={p.icon} /> {p.short}</li>)}
      </ul>
    </div>
    <div class="f-bottom">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <p>Hecho para las que cuidan.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--noir);
    color: var(--on-noir-2);
    padding-block: clamp(4rem, 3rem + 3vw, 6rem) calc(var(--s-6) + 4.5rem);
    font-size: var(--step--1);
  }
  .f-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--s-8);
  }
  .f-brand :global(.f-mark) {
    width: 3.5rem;
    margin-bottom: var(--s-5);
  }
  .f-brand :global(.f-word) {
    width: 13rem;
    margin-bottom: var(--s-4);
  }
  .f-brand p {
    max-width: 22rem;
  }
  .f-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }
  .f-title {
    margin-bottom: var(--s-4);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-200);
  }
  .f-cols ul {
    display: grid;
    gap: var(--s-3);
  }
  a {
    color: var(--on-noir);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }
  a:hover {
    color: var(--gold-200);
  }
  .f-social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .f-social :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--gold-400);
  }
  .f-pay {
    margin-top: var(--s-8);
    padding-block: var(--s-6);
    border-block: 1px solid var(--noir-line);
  }
  .f-pay ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    color: var(--on-noir);
  }
  .f-pay li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .f-pay :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--gold-400);
  }
  .f-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    padding-top: var(--s-5);
  }
  ::selection {
    background: var(--gold-400);
    color: var(--noir);
  }
  @media (max-width: 820px) {
    .f-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .f-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
