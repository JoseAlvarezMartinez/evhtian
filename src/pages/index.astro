---
import Shop from '../layouts/Shop.astro';
import Hero from '../components/Hero.astro';
import Collection from '../components/Collection.astro';
import FabricStory from '../components/FabricStory.astro';
import Manifesto from '../components/Manifesto.astro';
import Colors from '../components/Colors.astro';
import Payments from '../components/Payments.astro';
import Shipping from '../components/Shipping.astro';
import Returns from '../components/Returns.astro';
import Sizes from '../components/Sizes.astro';
import Faq from '../components/Faq.astro';
import { models } from '../data/catalog';
import { itemListNode, faqNode } from '../lib/seo';

const origin = Astro.site!;
const pageUrl = new URL('/', origin);
const schema = [itemListNode(models, origin), faqNode(pageUrl)];
---
<Shop schema={schema}>
  <Hero />
  <Collection />
  <FabricStory />
  <Manifesto />
  <Colors />
  <Payments />
  <Shipping />
  <Sizes />
  <Returns />
  <Faq />
</Shop>
