---
import { Picture } from 'astro:assets';
import Shop from '../../layouts/Shop.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import ProductCard from '../../components/ProductCard.astro';
import BuyForm from '../../components/BuyForm.astro';
import FabricStory from '../../components/FabricStory.astro';
import Sizes from '../../components/Sizes.astro';
import Icon from '../../components/Icon.astro';
import { colors, models, type ColorId, type Model } from '../../data/catalog';
import Lightbox from '../../components/Lightbox.astro';
import { detailPhotos, hasAllPhotos, hasColorDetails } from '../../data/photos';
import { site, formatARS, whatsappHref, saleOff, saleSaving } from '../../config/site';
import { tigre, returnsPolicy } from '../../config/shipping';
import { photoFor } from '../../data/photos';
import { breadcrumbNode, productGroupNode, shareImage, skuFor } from '../../lib/seo';

export function getStaticPaths() {
  return models.map((model) => ({ params: { slug: model.id }, props: { model } }));
}

interface Props {
  model: Model;
}
const { model } = Astro.props;
const defaults: Record<string, ColorId> = { essential: 'bordo', terra: 'marino' };
const color = defaults[model.id];
const other = models.find((m) => m.id !== model.id)!;
// Si cada color tiene sus detalles, se arma un juego por color y se muestra el del color elegido.
const detailSets = hasColorDetails(model.id)
  ? colors.map((c) => ({ color: c.id as ColorId | undefined, label: c.name.toLowerCase(), imgs: detailPhotos(model.id, c.id) }))
  : [{ color: undefined, label: '', imgs: detailPhotos(model.id) }];
const zoomable = hasAllPhotos(model.id);
const ask = whatsappHref(`¡Hola Evhtian! Quiero consultar por el ambo ${model.name}.`);

// SEO: título, descripción, imagen para compartir y datos estructurados del modelo.
const origin = Astro.site!;
const pageUrl = new URL(`/ambos/${model.id}/`, origin);
const colorName = colors.find((c) => c.id === color)!.name;
const title = `Ambo ${model.name} para mujer en bengalina elastizada | ${site.name}`;
const description = `Ambo ${model.name} para mujer en bengalina: ${model.summary}. 5 colores, talles XS a L, a ${formatARS(site.price)}. Envíos a todo el país.`;
const cover = photoFor(model.id, color);
const image = cover && { ...(await shareImage(cover, origin)), alt: `Ambo ${model.name} para mujer en ${colorName.toLowerCase()}, chaqueta y pantalón` };
const schema = [
  await productGroupNode(model, pageUrl, origin, model.description),
  breadcrumbNode([
    { name: 'Inicio', url: new URL('/', origin).href },
    { name: `Ambo ${model.name}`, url: pageUrl.href },
  ]),
];
---
<Shop
  title={title}
  description={description}
  image={image}
  ogType="product"
  product={{ sku: skuFor(model.id, color), group: model.id, price: site.price, color: colorName }}
  schema={schema}
>
  <div class="wrap crumbs">
    <nav aria-label="Ruta de navegación">
      <ol role="list">
        <li><a href="/">Inicio</a></li>
        <li><a href="/#coleccion">Colección</a></li>
        <li aria-current="page">Ambo {model.name}</li>
      </ol>
    </nav>
  </div>

  <section class={`wrap pdp c-${color}`} data-product data-viewer data-product-page data-model={model.id} data-color={color} aria-labelledby="pdp-title">
    <div class="pdp-gallery">
      <div class="pdp-main">
        <ProductVisual model={model.id} color={color} uid={`pdp-${model.id}`} eager sizes="(min-width: 960px) 40vw, 100vw" />
        <span class="pdp-chip">Chaqueta + pantalón · <span data-viewer-color-name></span></span>
        <span class="sale-badge pdp-photo-off" aria-hidden="true">{saleOff}% OFF</span>
        {zoomable && (
          <button class="pdp-zoom" type="button" data-zoom-open="0" aria-label={`Ampliar la foto del ambo ${model.name}`}>
            <span class="pdp-zoom-badge" aria-hidden="true"><Icon name="zoom" /> Ampliar</span>
          </button>
        )}
      </div>
      {detailSets.map((set) => set.imgs.length > 0 && (
        <div
          class:list={['pdp-details', set.color && 'pdp-set', set.color === color && 'is-active']}
          data-color-view={set.color}
        >
          {set.imgs.map((img, i) => (
            <button class="pdp-detail" type="button" data-zoom-open={i + 1} aria-label={`Ampliar la foto ${i + 2} del ambo ${model.name}`}>
              <Picture
                src={img}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200]}
                sizes="(min-width: 960px) 20vw, 50vw"
                alt={set.color ? `Ambo ${model.name} en ${set.label} (foto ${i + 2})` : `Detalle del ambo ${model.name} (${i + 1})`}
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      ))}
    </div>

    <div class="pdp-info">
      <h1 id="pdp-title">Ambo {model.name}</h1>
      <p class="pdp-tagline">{model.tagline}</p>
      <p class="pdp-price tnum">
        <s class="pdp-list was"><span class="sr-only">Antes: </span>{formatARS(site.listPrice)}</s>
        <span class="pdp-amount"><span class="sr-only">Ahora: </span>{formatARS(site.price)}</span>
        <span class="sale-badge pdp-off">{saleOff}% OFF</span>
        <span class="pdp-sub">Chaqueta + pantalón · <span class="saving">ahorrás {formatARS(saleSaving)}</span></span>
        <span class="pdp-sale"><strong>{site.sale.name}:</strong> este precio es solo hasta el {site.sale.until}.</span>
      </p>
      <p class="pdp-desc">{model.description}</p>
      <BuyForm uid="pdp" model={model.id} color={color} />
      <ul class="pdp-pay pdp-assure" role="list">
        <li><Icon name="truck" /> Envíos a todo el país</li>
        <li><Icon name="pin" /> Entrega en mano en {tigre.zone}</li>
        <li><Icon name="exchange" /> Cambio de talle en {returnsPolicy.exchangeDays} días</li>
        <li><Icon name="chat" /> Asesoramiento personal</li>
      </ul>
      <ul class="pdp-pay" role="list">
        {site.payments.map((p) => <li><Icon name={p.icon} /> {p.short}</li>)}
      </ul>
      <div class="pdp-links">
        <a class="link-arrow" href={ask} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> Consultanos por WhatsApp</a>
      </div>
    </div>
  </section>
  {zoomable && <Lightbox model={model.id} />}

  <section class="spec section" aria-labelledby="spec-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="spec-title" data-reveal>Cada detalle, <span class="accent">pensado para tu jornada.</span></h2>
      </header>
      <div class="spec-grid">
        <div class="spec-col" data-reveal>
          <h3>Chaqueta</h3>
          <dl>
            {model.jacket.map((f) => (
              <div><dt><Icon name="check" /> {f.title}</dt><dd>{f.text}</dd></div>
            ))}
          </dl>
        </div>
        <div class="spec-col i-1" data-reveal>
          <h3>Pantalón</h3>
          <dl>
            {model.pants.map((f) => (
              <div><dt><Icon name="check" /> {f.title}</dt><dd>{f.text}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <FabricStory />
  <Sizes />

  <section class="other section" aria-labelledby="other-title">
    <div class="wrap other-grid">
      <header>
        <h2 id="other-title">Conocé también el <span class="accent">ambo {other.name}.</span></h2>
        <p>{other.teaser} La misma tela, otra actitud.</p>
      </header>
      <ProductCard model={other} color={defaults[other.id]} uid={`other-${other.id}`} />
    </div>
  </section>
</Shop>

<style>
  .crumbs {
    padding-top: var(--s-5);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--line-strong);
  }
  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--ink);
    font-weight: 500;
  }

  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
    padding-block: var(--s-5) var(--section);
  }
  .pdp-gallery {
    display: grid;
    gap: var(--s-3);
  }
  .pdp-main {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(90% 70% at 50% 20%, #fffdf9 0%, rgb(255 253 249 / 0) 70%),
      var(--paper-3);
    overflow: hidden;
  }
  .pdp-main :global(.pv--art) {
    padding: 8% 22% 8%;
  }
  .pdp-chip {
    position: absolute;
    left: var(--s-4);
    top: var(--s-4);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgb(251 250 247 / 0.85);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .pdp-photo-off {
    position: absolute;
    right: var(--s-4);
    top: var(--s-4);
    z-index: 2;
    pointer-events: none;
    font-size: 0.8125rem;
    box-shadow: var(--shadow-1);
  }
  .pdp-zoom {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .pdp-zoom-badge {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-4);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem 0.45rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(251 250 247 / 0.9);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink);
    transition:
      background-color 160ms,
      border-color 160ms;
  }
  .pdp-zoom-badge :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .pdp-zoom:hover .pdp-zoom-badge,
  .pdp-zoom:focus-visible .pdp-zoom-badge {
    border-color: var(--ink);
    background: var(--paper);
  }
  .pdp-zoom:focus-visible {
    outline-offset: -4px;
  }
  .pdp-detail {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .pdp-detail :global(img) {
    transition: opacity 160ms;
  }
  .pdp-detail:hover :global(img) {
    opacity: 0.88;
  }
  .pdp-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }
  /* Un juego de detalles por color: solo se ve el del color elegido. */
  .pdp-set:not(.is-active) {
    display: none;
  }
  /* Con tres detalles, una fila de tres en vez de dejar una foto sola abajo. */
  .pdp-details:has(> :nth-child(3):last-child) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .pdp-details :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--paper-3);
  }

  .pdp-info {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  h1 {
    font-size: var(--step-4);
  }
  .pdp-tagline {
    margin-top: var(--s-2);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--gold-700);
  }
  .pdp-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.85rem;
    margin-top: var(--s-5);
    padding-block: var(--s-4);
    border-block: 1px solid var(--line);
  }
  .pdp-list {
    font-size: var(--step-2);
    font-weight: 500;
  }
  .pdp-amount {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .pdp-off {
    align-self: center;
    font-size: 0.8125rem;
  }
  .pdp-sub {
    flex-basis: 100%;
    margin-top: var(--s-1);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .pdp-sale {
    flex-basis: 100%;
    margin-top: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .pdp-sale strong {
    color: var(--gold-700);
    font-weight: 600;
  }
  .pdp-desc {
    margin-block: var(--s-5);
    color: var(--ink-2);
  }
  .pdp-pay {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-5);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .pdp-pay li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pdp-pay :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--gold-700);
    flex: none;
  }
  .pdp-assure {
    padding-block: var(--s-4);
    border-block: 1px solid var(--line);
    color: var(--ink);
    font-weight: 500;
  }
  .pdp-assure + .pdp-pay {
    margin-top: var(--s-4);
  }
  .pdp-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-5);
  }

  .spec {
    background: var(--paper-2);
  }
  .section-head .accent,
  .other .accent {
    color: var(--gold-700);
  }
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 3vw, 4rem);
  }
  .spec-col h3 {
    font-size: var(--step-2);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--ink);
  }
  .spec-col dl > div {
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .spec-col dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .spec-col dt :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--gold-700);
  }
  .spec-col dd {
    margin-top: var(--s-1);
    padding-left: 1.6rem;
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .i-1 {
    --i: 1;
  }

  .other-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    gap: clamp(2rem, 1rem + 4vw, 6rem);
    align-items: center;
  }
  .other h2 {
    font-size: var(--step-4);
  }
  .other header p {
    margin-top: var(--s-4);
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  @media (max-width: 960px) {
    .pdp,
    .other-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .pdp-info {
      position: static;
    }
  }
  @media (max-width: 700px) {
    .spec-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 420px) {
    .pdp-pay {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
